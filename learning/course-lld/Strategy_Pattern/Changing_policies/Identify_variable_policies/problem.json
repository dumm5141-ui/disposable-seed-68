      "title": "Define the policy contract",
      "body": "Both flat and percentage discounts should implement an apply(amount: number): number method.",
      "fileChanges": [
        {
          "path": "src/policy.ts",
          "operation": "UPDATE",
          "content": "export interface DiscountPolicy {\n  apply(amount: number): number;\n}\n\nexport class PercentageDiscount implements DiscountPolicy {\n  constructor(readonly percent: number) {}\n  apply(amount: number): number {\n    return amount * (1 - this.percent / 100);\n  }\n}\n"
