  "hints": [
    {
      "id": "hint-counter-1",
      "title": "Mark the component as a Client Component",
      "body": "Next.js App Router renders on the server by default. Add `'use client'` at the top of counter.tsx to enable React hooks like `useState`."
    },
    {
      "id": "hint-counter-2",
      "title": "Wire up the counter state",
      "body": "Use `useState(0)` for the count and attach an `onClick` handler that calls `setCount(c => c + 1)`.",
      "fileChanges": [
        {
          "path": "app/counter.tsx",
          "operation": "UPDATE",
          "content": "'use client';\nimport { useState } from 'react';\n\nexport function Counter() {\n  const [count, setCount] = useState(0);\n  return (\n    <div style={{ textAlign: 'center', marginTop: '4rem' }}>\n      <h2>Count: {count}</h2>\n      <button onClick={() => setCount((c) => c + 1)}>Increment</button>\n    </div>\n  );\n}\n"
        },
        {
          "path": "app/page.tsx",
          "operation": "UPDATE",
          "content": "import { Counter } from './counter';\n\nexport default function Page() {\n  return (\n    <main>\n      <h1>Next.js Counter</h1>\n      <Counter />\n    </main>\n  );\n}\n"
        }
      ]
    }
